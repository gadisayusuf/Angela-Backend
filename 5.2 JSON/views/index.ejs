<!DOCTYPE html>
<html>

<head>
  <title>Taco Recipes</title>
  <link rel="stylesheet" type="text/css" href="/styles/main.css">
</head>

<body>
  <h1>Taco Town 🌮</h1>

  <form action="/recipe" method="POST" class="buttons">
    <button type="submit" value="chicken" name="choice">🍗</button>
    <button type="submit" value="beef" name="choice">🥩</button>
    <button type="submit" value="fish" name="choice">🐟</button>
  </form>
  <div id="recipeContainer" class="hidden">

    <!-- If no recipe yet, show: -->
    <% if (!locals.data) {%>
      <h2>Pick your favourite taco ingredient 👆</h2>
      <% } else { %>
        <h2>
          <%= data.name %>
        </h2>
        <!-- Else, show the recipe name e.g. <h2>Recipe name</h2>-->
        <h3>Ingredients:</h3>
        <ul id="ingredientsList">
          <li>
            <%= data.ingredients.protein.name%>
              <%= data.ingredients.protein.preparation %>
          </li>
          <li>
            <%= data.ingredients.salsa.name %>
          </li>
          <% data.ingredients.toppings.forEach(topping=>{%>
            <li>
              <%=topping.quantity%> of <%= topping.name %>
            </li>
            <% }) %>
              <!-- <li>
            <%# data.ingredients.toppings[0].quantity %> of <%# data.ingredients.toppings[0].name %>
          </li>
          <li>
            <%# data.ingredients.toppings[1].quantity %> of <%# data.ingredients.toppings[1].name %>
          </li>
          <li>
            <%# data.ingredients.toppings[2].quantity %> of <%# data.ingredients.toppings[2].name %>
          </li> -->

        </ul>
        <% } %>


  </div>
</body>

</html>